{
  "name": "dodo-box",
  "version": "0.9.12",
  "build": "607250121",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "next clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "docker:build": "cross-var docker build -t $npm_package_name:$npm_package_version -t $npm_package_name:latest .",
    "docker:run": "cross-var docker run --rm -p 3000:3000 --env-file .env.local $npm_package_name:$npm_package_version",
    "docker:push": "cross-var \"docker push $npm_package_name:$npm_package_version && docker push $npm_package_name:latest\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "loc": "find . -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' -o -name '*.css' \\) ! -path '*/node_modules/*' ! -path '*/.next/*' ! -path '*/dist/*' | sort | xargs wc -l",
    "loc:summary": "find . -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' -o -name '*.css' \\) ! -path '*/node_modules/*' ! -path '*/.next/*' ! -path '*/dist/*' | xargs wc -l 2>/dev/null | tail -1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:site": "playwright test --config playwright.site.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm test && pnpm test:e2e",
    "cap:export": "node scripts/cap-build-export.js",
    "cap:sync": "npx cap sync android",
    "cap:build": "pnpm cap:export && pnpm cap:sync",
    "cap:apk:debug": "rm -rf .next && node scripts/sync-version.js && pnpm cap:build && cd android && ./gradlew assembleDebug",
    "cap:apk:release": "rm -rf .next && node scripts/sync-version.js && pnpm cap:build && cd android && ./gradlew assembleRelease && cd .. && node scripts/copy-apk-to-download.js",
    "cap:bundle": "node scripts/sync-version.js && node scripts/cap-bundle.js",
    "cap:upload": "bash scripts/cap-upload.sh",
    "cap:open": "npx cap open android",
    "cap:deploy": "bash scripts/cap-deploy.sh",
    "cli": "npx tsx cli/main.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-logger": "^5.0.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capgo/capacitor-updater": "^8.43.11",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@welshman/lib": "^0.8.9",
    "@welshman/net": "^0.8.9",
    "@welshman/signer": "^0.8.9",
    "@welshman/util": "^0.8.9",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-themes": "^0.4.6",
    "nostr-tools": "^2.23.3",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.1.0",
    "cross-var": "^1.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "jsdom": "^29.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "ws": "^8.21.1"
  }
}
