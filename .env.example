# dodo-box 环境变量配置示例
# 复制此文件为 .env.local 并填写实际值

NEXT_PUBLIC_DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol
NEXT_PUBLIC_VAULT_SALT=dodobox-vault-v1

# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY - 仅在运行时通过 docker-compose 环境变量注入，不要写入 .env 文件
# 生成方式: openssl rand -base64 32

# OTA Update manifest URL (Capacitor builds inline this into bundle)
NEXT_PUBLIC_UPDATE_URL=https://your-server.com/updates/manifest.json

# App version (auto-read from package.json, can override manually)
NEXT_PUBLIC_APP_VERSION=0.8.8

# Default message TTL in seconds (0 = permanent)
# Examples: 600 (10min), 3600 (1hour), 86400 (1day), 2592000 (30days)
# Users can override in Settings page; CLI uses DEFAULT_MESSAGE_TTL
NEXT_PUBLIC_DEFAULT_MESSAGE_TTL=0

# ---- Mock Telegram Service (built-in, no separate container) ----
# Set adapter mode to 'mock-telegram' in Settings to use the built-in mock.
# These env vars configure the mock bot identity.
NEXT_PUBLIC_MOCK_TELEGRAM_TOKEN=mock-bot-token-12345
MOCK_BOT_USERNAME=dodobox_bot
MOCK_BOT_FIRST_NAME=DodoBox Bot
